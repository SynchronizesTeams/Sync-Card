---
// paper-card — configuration dashboard. Same generator mechanism as Sync-Card,
// restyled to the "clean light ops paper" design language.
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <header class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5 sm:px-8">
      <a href="/" class="font-mono text-xs uppercase tracking-widest">SynchronizeTeams<span class="text-accent">:~$</span></a>
      <a href="/api/card.svg" class="font-mono text-[11px] uppercase tracking-widest text-ink-2 transition-colors hover:text-accent">raw svg</a>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-16">
    <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-14">

      <section class="lg:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-widest text-ink-2">$ card --configure</p>
        <h1 class="mt-3 font-display text-4xl leading-[1.05] font-semibold tracking-tight sm:text-5xl">
          An ID card,<br />printed on paper.
        </h1>
        <p class="mt-4 max-w-prose text-sm leading-relaxed text-ink-2">
          Fill the sheet, pan and zoom the portrait directly on the preview, then copy the
          Markdown line. The server returns one self-contained SVG — images and QR embedded.
        </p>

        <form id="config-form" class="mt-10 border-t border-line">
          <div class="grid gap-5 border-b border-line py-6 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label class="label" for="input-nama">Name</label>
              <input type="text" id="input-nama" value="John Doe" class="field" />
            </div>
            <div class="flex flex-col gap-2">
              <label class="label" for="input-role">Role / subtitle</label>
              <input type="text" id="input-role" value="Software Engineer" class="field" />
            </div>
            <div class="flex flex-col gap-2 sm:col-span-2">
              <label class="label" for="input-qr">QR destination</label>
              <input type="text" id="input-qr" value="https://github.com/johndoe" class="field" />
            </div>
            <div class="flex flex-col gap-2">
              <label class="label" for="input-brand">Wordmark</label>
              <input type="text" id="input-brand" value="SynchronizeTeams" class="field" />
            </div>
            <div class="flex flex-col gap-2">
              <label class="label" for="input-meta">Corner label</label>
              <input type="text" id="input-meta" value="ID / SVG" class="field" />
            </div>
          </div>

          <div class="grid gap-5 border-b border-line py-6 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label class="label" for="input-gambar">Avatar URL</label>
              <input type="url" id="input-gambar" placeholder="https://github.com/username.png" class="field" />
            </div>
            <div class="flex flex-col gap-2">
              <span class="label">Or upload a file</span>
              <div class="flex gap-2">
                <input type="file" id="input-file" accept="image/*" class="hidden" />
                <button type="button" id="file-trigger-btn" class="btn-ghost flex-1">choose file</button>
                <button type="button" id="file-clear-btn" class="btn-ghost hidden">clear</button>
              </div>
            </div>
            <p class="font-mono text-[10px] leading-relaxed text-ink-2 sm:col-span-2">
              Upload wins over URL. Stored in SQLite, referenced as db:&lt;id&gt;.
            </p>
          </div>

          <div class="grid gap-5 border-b border-line py-6 sm:grid-cols-3">
            <div class="flex flex-col gap-2">
              <label class="label flex justify-between" for="input-scale">
                <span>Zoom</span><span id="label-scale" class="text-ink">1.33x</span>
              </label>
              <input type="range" id="input-scale" min="0.5" max="3.0" step="0.05" value="1.33" />
            </div>
            <div class="flex flex-col gap-2">
              <label class="label flex justify-between" for="input-pan-x">
                <span>Pan X</span><span id="label-pan-x" class="text-ink">-26px</span>
              </label>
              <input type="range" id="input-pan-x" min="-150" max="150" step="1" value="-26" />
            </div>
            <div class="flex flex-col gap-2">
              <label class="label flex justify-between" for="input-pan-y">
                <span>Pan Y</span><span id="label-pan-y" class="text-ink">0px</span>
              </label>
              <input type="range" id="input-pan-y" min="-150" max="150" step="1" value="0" />
            </div>
          </div>

          <div class="grid gap-4 border-b border-line py-6 sm:grid-cols-[auto_auto_1fr] sm:items-center">
            <label class="label" for="input-img-bg">Photo backdrop</label>
            <div class="flex items-center gap-2">
              <input type="color" id="input-img-bg" value="#f1ede5" class="swatch" title="Custom colour" />
              <span id="label-img-bg" class="font-mono text-[11px] text-ink-2">#f1ede5</span>
            </div>
            <div class="flex flex-wrap items-center gap-2 sm:justify-end">
                <button type="button" data-color="#f1ede5" class="swatch-btn bg-[#f1ede5]" title="Paper 2"></button>
                <button type="button" data-color="#e2dcd0" class="swatch-btn bg-[#e2dcd0]" title="Line"></button>
                <button type="button" data-color="#e4572e" class="swatch-btn bg-[#e4572e]" title="Vermilion"></button>
                <button type="button" data-color="#c9c2b4" class="swatch-btn bg-[#c9c2b4]" title="Sand"></button>
                <button type="button" data-color="#ffffff" class="swatch-btn bg-[#ffffff]" title="White"></button>
              </div>
          </div>

          <div class="grid gap-5 border-b border-line py-6 sm:grid-cols-2">
            <div class="flex flex-col gap-2 sm:col-span-2">
              <label class="label" for="input-tags">Tags (comma separated)</label>
              <input type="text" id="input-tags" value="Linux, Networking, Automation" class="field" />
            </div>
            <div class="flex flex-col gap-2">
              <label class="label" for="input-ig">Instagram</label>
              <input type="text" id="input-ig" value="@johndoe" class="field" />
            </div>
            <div class="flex flex-col gap-2">
              <label class="label" for="input-website">Website</label>
              <input type="text" id="input-website" value="johndoe.com" class="field" />
            </div>
          </div>

          <div class="flex flex-wrap gap-x-10 gap-y-4 border-b border-line py-6">
            <label class="flex cursor-pointer items-center gap-3 select-none">
              <input type="checkbox" id="input-dark" class="check" />
              <span class="font-mono text-[11px] uppercase tracking-widest">Ink mode</span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 select-none">
              <input type="checkbox" id="input-landscape" class="check" />
              <span class="font-mono text-[11px] uppercase tracking-widest">Landscape</span>
            </label>
          </div>
        </form>
      </section>

      <aside class="flex flex-col gap-6 lg:col-span-5 lg:sticky lg:top-20">
        <div>
          <div class="flex items-baseline justify-between">
            <span class="label">live preview</span>
            <span class="font-mono text-[10px] uppercase tracking-widest text-ink-2">drag / scroll to crop</span>
          </div>
          <div class="mt-3 flex min-h-[480px] items-center justify-center border border-line bg-paper-2 p-6">
            <div id="card-preview" class="flex w-full items-center justify-center"></div>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between">
            <span class="label">markdown embed</span>
            <button id="copy-btn" class="btn-ghost">copy</button>
          </div>
          <div class="mt-3 border border-line bg-paper-2 p-3">
            <code id="embed-code" class="block font-mono text-[11px] leading-relaxed break-all text-ink-2 select-all">Loading...</code>
          </div>
          <p class="mt-3 font-mono text-[10px] leading-relaxed text-ink-2">
            Server fetches and base64-encodes the avatar, so the SVG renders inside GitHub.
          </p>
        </div>
      </aside>

    </div>
  </main>
</Layout>

<script type="text/javascript">
  const form = document.getElementById('config-form');
  const inputs = {
    nama: document.getElementById('input-nama'),
    role: document.getElementById('input-role'),
    qr: document.getElementById('input-qr'),
    brand: document.getElementById('input-brand'),
    meta: document.getElementById('input-meta'),
    gambar: document.getElementById('input-gambar'),
    tags: document.getElementById('input-tags'),
    ig: document.getElementById('input-ig'),
    website: document.getElementById('input-website'),
    dark: document.getElementById('input-dark'),
    landscape: document.getElementById('input-landscape'),
    scale: document.getElementById('input-scale'),
    panX: document.getElementById('input-pan-x'),
    panY: document.getElementById('input-pan-y'),
    imgBg: document.getElementById('input-img-bg')
  };
  const cardPreview = document.getElementById('card-preview');
  const embedCode = document.getElementById('embed-code');
  const copyBtn = document.getElementById('copy-btn');

  const fileInput = document.getElementById('input-file');
  const fileTriggerBtn = document.getElementById('file-trigger-btn');
  const fileClearBtn = document.getElementById('file-clear-btn');

  const labelScale = document.getElementById('label-scale');
  const labelPanX = document.getElementById('label-pan-x');
  const labelPanY = document.getElementById('label-pan-y');

  let uploadedBase64 = '';
  let currentFile = null;

  // default crops: the shared face.png is framed differently per layout
  const CROP_PRESETS = {
    portrait: { scale: 1.33, x: -26, y: 0 },
    landscape: { scale: 1.0, x: 0, y: 30 }
  };
  function applyCropPreset() {
    if (uploadedBase64) return;
    const p = inputs.landscape.checked ? CROP_PRESETS.landscape : CROP_PRESETS.portrait;
    inputs.scale.value = p.scale;
    inputs.panX.value = p.x;
    inputs.panY.value = p.y;
    updateSliderLabels();
  }

  async function uploadImage(file) {
    const formData = new FormData();
    formData.append('file', file);

    const res = await fetch('/api/upload', { method: 'POST', body: formData });
    if (!res.ok) throw new Error('Upload failed');
    const data = await res.json();
    return data.id;
  }

  fileTriggerBtn.addEventListener('click', () => fileInput.click());

  fileInput.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    currentFile = file;
    try {
      fileTriggerBtn.textContent = 'uploading...';
      fileTriggerBtn.disabled = true;

      const id = await uploadImage(file);
      uploadedBase64 = 'db:' + id;

      // A fresh upload is uncropped: reset to identity transform.
      inputs.scale.value = '1.0';
      inputs.panX.value = '0';
      inputs.panY.value = '0';
      updateSliderLabels();
      updateAvatarTransformClient(0, 0, 1.0);

      fileTriggerBtn.textContent = file.name.substring(0, 12) + (file.name.length > 12 ? '...' : '');
      fileTriggerBtn.disabled = false;
      fileClearBtn.classList.remove('hidden');
      updatePreview();
    } catch (err) {
      console.error('File upload failed:', err);
      fileTriggerBtn.textContent = 'error';
      fileTriggerBtn.disabled = false;
    }
  });

  fileClearBtn.addEventListener('click', () => {
    fileInput.value = '';
    currentFile = null;
    uploadedBase64 = '';

    fileTriggerBtn.textContent = 'choose file';
    fileClearBtn.classList.add('hidden');

    applyCropPreset();
    updatePreview();
  });

  const presetColors = document.querySelectorAll('[data-color]');
  function syncSwatches() {
    const current = inputs.imgBg.value.toLowerCase();
    document.getElementById('label-img-bg').textContent = current;
    presetColors.forEach(btn => {
      btn.classList.toggle('is-active', btn.getAttribute('data-color').toLowerCase() === current);
    });
  }
  presetColors.forEach(btn => {
    btn.addEventListener('click', () => {
      inputs.imgBg.value = btn.getAttribute('data-color');
      syncSwatches();
      updatePreview();
    });
  });
  inputs.imgBg.addEventListener('input', syncSwatches);

  function updateSliderLabels() {
    labelScale.textContent = `${parseFloat(inputs.scale.value).toFixed(2)}x`;
    labelPanX.textContent = `${inputs.panX.value}px`;
    labelPanY.textContent = `${inputs.panY.value}px`;
  }

  ['scale', 'panX', 'panY'].forEach(key => {
    inputs[key].addEventListener('input', () => {
      updateSliderLabels();
      updateAvatarTransformClient(parseFloat(inputs.panX.value), parseFloat(inputs.panY.value), parseFloat(inputs.scale.value));
      updatePreview(true);
      syncServerPreviewDebounced();
    });
  });

  let syncTimeout = null;
  function syncServerPreviewDebounced() {
    if (syncTimeout) clearTimeout(syncTimeout);
    syncTimeout = setTimeout(() => updatePreview(false), 250);
  }

  function updateAvatarTransformClient(panX, panY, scale) {
    const avatarImage = cardPreview.querySelector('#avatar-pattern image');
    if (avatarImage) {
      avatarImage.setAttribute('transform', `translate(${panX}, ${panY}) scale(${scale})`);
      const origin = inputs.landscape.checked ? '58 77.5' : '78 147.5';
      avatarImage.setAttribute('transform-origin', origin);
    }
  }

  async function updatePreview(skipServerFetch = false) {
    const params = new URLSearchParams();

    if (inputs.nama.value.trim()) params.append('nama', inputs.nama.value.trim());
    if (inputs.role.value.trim()) params.append('role', inputs.role.value.trim());
    if (inputs.qr.value.trim()) params.append('qr', inputs.qr.value.trim());
    params.append('brand', inputs.brand.value);
    params.append('meta', inputs.meta.value);

    if (uploadedBase64) {
      params.append('gambar', uploadedBase64);
    } else if (inputs.gambar.value.trim()) {
      params.append('gambar', inputs.gambar.value.trim());
    }

    params.append('img_scale', inputs.scale.value);
    params.append('img_x', inputs.panX.value);
    params.append('img_y', inputs.panY.value);
    params.append('img_bg', inputs.imgBg.value.replace('#', ''));

    if (inputs.tags.value.trim()) params.append('tags', inputs.tags.value.trim());
    if (inputs.ig.value.trim()) params.append('ig', inputs.ig.value.trim());
    if (inputs.website.value.trim()) params.append('website', inputs.website.value.trim());
    if (inputs.dark.checked) params.append('dark', 'true');
    if (inputs.landscape.checked) params.append('landscape', 'true');

    const previewUrl = `/api/card.svg?${params.toString()}`;
    embedCode.textContent = `![My ID Card](${window.location.origin}${previewUrl})`;

    if (skipServerFetch) return;

    try {
      const res = await fetch(previewUrl);
      if (res.ok) cardPreview.innerHTML = await res.text();
    } catch (err) {
      console.error('Failed to load card SVG:', err);
    }
  }

  ['nama', 'role', 'qr', 'brand', 'meta', 'gambar', 'tags', 'ig', 'website', 'imgBg'].forEach(key => {
    inputs[key].addEventListener('input', () => updatePreview());
  });

  ['dark', 'landscape'].forEach(key => {
    inputs[key].addEventListener('change', () => {
      if (key === 'landscape') {
        applyCropPreset();
        updateAvatarTransformClient(parseFloat(inputs.panX.value), parseFloat(inputs.panY.value), parseFloat(inputs.scale.value));
      }
      updatePreview();
    });
  });

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(embedCode.textContent).then(() => {
      copyBtn.textContent = 'copied';
      setTimeout(() => { copyBtn.textContent = 'copy'; }, 1500);
    });
  });

  // --- drag & zoom straight on the card ---
  let isDragging = false;
  let startX = 0;
  let startY = 0;
  let startPanX = 0;
  let startPanY = 0;

  const SVG_SIZE = () => ({
    w: inputs.landscape.checked ? 620 : 420,
    h: inputs.landscape.checked ? 320 : 490
  });

  // rendered SVG box inside its container (object-fit: contain maths)
  function renderedBox() {
    const rect = cardPreview.getBoundingClientRect();
    const { w: svgW, h: svgH } = SVG_SIZE();
    const svgAspect = svgW / svgH;
    const containerAspect = rect.width / rect.height;
    let width = rect.width;
    let height = rect.height;
    let offsetX = 0;
    let offsetY = 0;
    if (containerAspect > svgAspect) {
      width = rect.height * svgAspect;
      offsetX = (rect.width - width) / 2;
    } else {
      height = rect.width / svgAspect;
      offsetY = (rect.height - height) / 2;
    }
    return { rect, svgW, svgH, width, height, offsetX, offsetY };
  }

  function isOverAvatar(clientX, clientY) {
    const { rect, svgW, svgH, width, height, offsetX, offsetY } = renderedBox();
    if (rect.width === 0 || rect.height === 0) return false;

    const localX = (clientX - (rect.left + offsetX)) * (svgW / width);
    const localY = (clientY - (rect.top + offsetY)) * (svgH / height);

    return inputs.landscape.checked
      ? localX >= 32 && localX <= 148 && localY >= 68 && localY <= 223
      : localX >= 226 && localX <= 382 && localY >= 85 && localY <= 380;
  }

  cardPreview.addEventListener('mousemove', (e) => {
    if (isDragging) return;
    cardPreview.style.cursor = isOverAvatar(e.clientX, e.clientY) ? 'grab' : 'default';
  });

  cardPreview.addEventListener('mousedown', (e) => {
    if (e.button !== 0) return;
    if (!isOverAvatar(e.clientX, e.clientY)) return;
    isDragging = true;
    startX = e.clientX;
    startY = e.clientY;
    startPanX = parseFloat(inputs.panX.value) || 0;
    startPanY = parseFloat(inputs.panY.value) || 0;
    cardPreview.style.cursor = 'grabbing';
    e.preventDefault();
  });

  function dragTo(clientX, clientY) {
    const { svgW, svgH, width, height } = renderedBox();
    if (width === 0) return;

    const dx = (clientX - startX) * (svgW / width);
    const dy = (clientY - startY) * (svgH / height);

    const clamp = (v, el) => Math.max(parseFloat(el.min), Math.min(parseFloat(el.max), v));

    inputs.panX.value = Math.round(clamp(startPanX + dx, inputs.panX));
    inputs.panY.value = Math.round(clamp(startPanY + dy, inputs.panY));

    updateSliderLabels();
    updateAvatarTransformClient(parseFloat(inputs.panX.value), parseFloat(inputs.panY.value), parseFloat(inputs.scale.value));
    updatePreview(true);
    syncServerPreviewDebounced();
  }

  window.addEventListener('mousemove', (e) => {
    if (isDragging) dragTo(e.clientX, e.clientY);
  });

  window.addEventListener('mouseup', () => {
    if (!isDragging) return;
    isDragging = false;
    cardPreview.style.cursor = 'grab';
  });

  cardPreview.addEventListener('wheel', (e) => {
    if (!isOverAvatar(e.clientX, e.clientY)) return;
    e.preventDefault();

    const step = 0.05;
    let next = (parseFloat(inputs.scale.value) || 1.0) + (e.deltaY < 0 ? step : -step);
    next = Math.max(parseFloat(inputs.scale.min), Math.min(parseFloat(inputs.scale.max), next));
    inputs.scale.value = next.toFixed(2);

    updateSliderLabels();
    updateAvatarTransformClient(parseFloat(inputs.panX.value), parseFloat(inputs.panY.value), next);
    updatePreview(true);
    syncServerPreviewDebounced();
  }, { passive: false });

  // touch
  cardPreview.addEventListener('touchstart', (e) => {
    if (e.touches.length !== 1) return;
    const touch = e.touches[0];
    if (!isOverAvatar(touch.clientX, touch.clientY)) return;
    isDragging = true;
    startX = touch.clientX;
    startY = touch.clientY;
    startPanX = parseFloat(inputs.panX.value) || 0;
    startPanY = parseFloat(inputs.panY.value) || 0;
    e.preventDefault();
  }, { passive: false });

  window.addEventListener('touchmove', (e) => {
    if (!isDragging || e.touches.length !== 1) return;
    dragTo(e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: false });

  window.addEventListener('touchend', () => { isDragging = false; });

  updateSliderLabels();
  syncSwatches();
  updatePreview();
</script>
